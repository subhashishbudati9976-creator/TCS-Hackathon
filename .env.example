# BranchIQ — Root environment variables example
# Copy to .env and fill in values. Never commit .env to version control.

# ─── Backend ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./branchiq.db
ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api
