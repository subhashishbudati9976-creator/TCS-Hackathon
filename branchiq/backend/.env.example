# BranchIQ Backend Environment Variables
# Copy this file to .env and fill in your values.

# Application settings
APP_ENV=development
APP_VERSION=0.1.0

# Database — SQLite path (relative to backend directory)
DATABASE_URL=sqlite:///./branchiq.db

# CORS — comma-separated list of allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:5173

# (Future) PostgreSQL connection string — leave blank until migrating
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/branchiq
